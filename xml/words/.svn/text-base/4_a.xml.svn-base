<?xml version="1.0" encoding="UTF-8"?>
<page>
	<words>
				<item>
			<word><![CDATA[a]]></word>
			<type><![CDATA[ ]]></type>
			<chinese><![CDATA[[用于未曾提及或事先不知道的人或物名称前]]]></chinese>
			<english><![CDATA[used before a noun that names something or someone that has not been mentioned before,or that the person you are talking to does not know about]]></english>
			<example><![CDATA[We have a problem.]]></example>
			<important>1</important>
			<mediafile>http://www.bingoenglish.com/mediafile/words/a/a.mp3</mediafile>
		</item>
				<item>
			<word><![CDATA[a]]></word>
			<type><![CDATA[ ]]></type>
			<chinese><![CDATA[[用于名词前泛指一类事物]]]></chinese>
			<english><![CDATA[used before a noun to mean all things of that type]]></english>
			<example><![CDATA[A square has four sides.]]></example>
			<important>1</important>
			<mediafile>http://www.bingoenglish.com/mediafile/words/a/a.mp3</mediafile>
		</item>
				<item>
			<word><![CDATA[a]]></word>
			<type><![CDATA[ ]]></type>
			<chinese><![CDATA[[用于两个经常被一起提及因此被看作是一个物体的名词前]]]></chinese>
			<english><![CDATA[used before two nouns that are mentioned together so often that they are thought of as one thing]]></english>
			<example><![CDATA[I'll fetch you a cup and saucer.]]></example>
			<important>1</important>
			<mediafile>http://www.bingoenglish.com/mediafile/words/a/a.mp3</mediafile>
		</item>
				<item>
			<word><![CDATA[a]]></word>
			<type><![CDATA[ ]]></type>
			<chinese><![CDATA[一种[用于不可数名词前表示种类]]]></chinese>
			<english><![CDATA[used before an uncountable noun to mean a type of it]]></english>
			<example><![CDATA[Candidates must have a good knowledge of chemistry.]]></example>
			<important>1</important>
			<mediafile>http://www.bingoenglish.com/mediafile/words/a/a.mp3</mediafile>
		</item>
				<item>
			<word><![CDATA[a]]></word>
			<type><![CDATA[ ]]></type>
			<chinese><![CDATA[[用于画家或艺术家等的名字前表示其作品]]]></chinese>
			<english><![CDATA[used before the name of a painter or artist etc meaning a particular painting, sculpture etc by that person]]></english>
			<example><![CDATA[Most people have very little difficulty in seeing why a Van Gogh is a work of genius.]]></example>
			<important>1</important>
			<mediafile>http://www.bingoenglish.com/mediafile/words/a/a.mp3</mediafile>
		</item>
				<item>
			<word><![CDATA[a]]></word>
			<type><![CDATA[ ]]></type>
			<chinese><![CDATA[[用于某人或某物的名字前指与其具有同样特性的人或物]]]></chinese>
			<english><![CDATA[used before a name to mean having the same qualities as that person or thing]]></english>
			<example><![CDATA[She was hailed as a new Marilyn Monroe.]]></example>
			<important>1</important>
			<mediafile>http://www.bingoenglish.com/mediafile/words/a/a.mp3</mediafile>
		</item>
				<item>
			<word><![CDATA[a]]></word>
			<type><![CDATA[ ]]></type>
			<chinese><![CDATA[[置于such, what, rather和（正式）many后表示强调]]]></chinese>
			<english><![CDATA[used after such, what, rather and (formal) many to emphasize what you are saying]]></english>
			<example><![CDATA[What a day! I was late for work and my car broke down.]]></example>
			<important>1</important>
			<mediafile>http://www.bingoenglish.com/mediafile/words/a/a.mp3</mediafile>
		</item>
				<item>
			<word><![CDATA[abandon]]></word>
			<type><![CDATA[vt ]]></type>
			<chinese><![CDATA[抛弃，遗弃（某人）]]></chinese>
			<english><![CDATA[to leave someone,especially someone you are responsible for]]></english>
			<example><![CDATA[How could she abandon her own child?]]></example>
			<important>1</important>
			<mediafile>http://www.bingoenglish.com/mediafile/words/a/abandon.mp3</mediafile>
		</item>
				<item>
			<word><![CDATA[abandon]]></word>
			<type><![CDATA[vt ]]></type>
			<chinese><![CDATA[离弃，逃离（某地方或交通工具等）]]></chinese>
			<english><![CDATA[to go away from a place, vehicle etc, permanently, especially because the situation makes it impossibe for you to stay]]></english>
			<example><![CDATA[We had to abandon the car and walk the rest of the way.]]></example>
			<important>1</important>
			<mediafile>http://www.bingoenglish.com/mediafile/words/a/abandon.mp3</mediafile>
		</item>
				<item>
			<word><![CDATA[abandon]]></word>
			<type><![CDATA[vt ]]></type>
			<chinese><![CDATA[放弃，中止]]></chinese>
			<english><![CDATA[to stop doing something because there are too many problems and it is impossible to continue]]></english>
			<example><![CDATA[The game had to be abandoned due to bad weather.]]></example>
			<important>1</important>
			<mediafile>http://www.bingoenglish.com/mediafile/words/a/abandon.mp3</mediafile>
		</item>
				<item>
			<word><![CDATA[abandon]]></word>
			<type><![CDATA[vt ]]></type>
			<chinese><![CDATA[]]></chinese>
			<english><![CDATA[]]></english>
			<example><![CDATA[They were accused of abandoning their socialist principles.]]></example>
			<important>1</important>
			<mediafile>http://www.bingoenglish.com/mediafile/words/a/abandon.mp3</mediafile>
		</item>
				<item>
			<word><![CDATA[ability]]></word>
			<type><![CDATA[countable/uncountable noun ]]></type>
			<chinese><![CDATA[能力；技能；本领]]></chinese>
			<english><![CDATA[something that you are able to do, especially because you have a particular mental or physical skill]]></english>
			<example><![CDATA[She has great ability to play the piano.]]></example>
			<important>1</important>
			<mediafile>http://www.bingoenglish.com/mediafile/words/a/ability.mp3</mediafile>
		</item>
				<item>
			<word><![CDATA[ability]]></word>
			<type><![CDATA[countable/uncountable noun ]]></type>
			<chinese><![CDATA[智能，智力]]></chinese>
			<english><![CDATA[someone's, especially a student's, level of intelligence or skill, especially in school or college work]]></english>
			<example><![CDATA[There are children of all abilities in my class.]]></example>
			<important>1</important>
			<mediafile>http://www.bingoenglish.com/mediafile/words/a/ability.mp3</mediafile>
		</item>
				<item>
			<word><![CDATA[able]]></word>
			<type><![CDATA[adj ]]></type>
			<chinese><![CDATA[有能力做某事，会做某事]]></chinese>
			<english><![CDATA[to have the skill, strength, knowledge etc. to do something]]></english>
			<example><![CDATA[Thomas is expected to be able to play again next weekend.]]></example>
			<important>1</important>
			<mediafile>http://www.bingoenglish.com/mediafile/words/a/able.mp3</mediafile>
		</item>
				<item>
			<word><![CDATA[able]]></word>
			<type><![CDATA[adj ]]></type>
			<chinese><![CDATA[可以去做某事]]></chinese>
			<english><![CDATA[to have the chance to do something because the situation makes it possible for you to do it]]></english>
			<example><![CDATA[In 1944, we were able to return to Hawaii.]]></example>
			<important>1</important>
			<mediafile>http://www.bingoenglish.com/mediafile/words/a/able.mp3</mediafile>
		</item>
				<item>
			<word><![CDATA[able]]></word>
			<type><![CDATA[adj ]]></type>
			<chinese><![CDATA[熟练的；胜任的，称职的]]></chinese>
			<english><![CDATA[clever or good at doing something, especially at doing an important job]]></english>
			<example><![CDATA[He is an able judge.]]></example>
			<important>1</important>
			<mediafile>http://www.bingoenglish.com/mediafile/words/a/able.mp3</mediafile>
		</item>
				<item>
			<word><![CDATA[abnormal]]></word>
			<type><![CDATA[adj ]]></type>
			<chinese><![CDATA[不正常的，反常的；变态的]]></chinese>
			<english><![CDATA[very different from usual in a way that seems strange, worrying, wrong, or dangerous]]></english>
