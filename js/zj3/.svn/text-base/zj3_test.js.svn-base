$('#materials_div').block(
		{ 
			message: $('#div_no_validip'),
			overlayCSS:  {  
        		backgroundColor:'#000',  
        		opacity:        '0.8'  
    		},
    		css:{
    			padding:        0, 
		        margin:         0, 
		        width:          '30%',  
		        position:       'fixed',
		        left:           '50%',  
		        textAlign:      'center',  
		        color:          '#000',  
		        border:         '3px solid #aaa', 
		        backgroundColor:'#fff', 
		        cursor:         'auto' 
    		}
    	}
	);
}