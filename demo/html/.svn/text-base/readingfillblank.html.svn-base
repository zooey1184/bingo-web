<!DOCTYPE html PUBLIC "-//W3C//DTD HTML 4.01 Transitional//EN" "http://www.w3.org/TR/html4/loose.dtd">
<html>
<head>
<meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
<script language="javascript">AC_FL_RunContent = 0;</script>
<script src="/st/js/AC_RunActiveContent.js" language="javascript"></script>
<script src="/st/js/jquery-1.2.6.min.js" language="javascript"></script>
<script src="/st/js/demo.js" language="javascript"></script>
 <link href="/st/css/demo.css" rel="stylesheet" type="text/css" />
<title>Demo 选词填空</title>
</head>
<body>
<script language="javascript">
	if (AC_FL_RunContent == 0) {
		alert(" AC_RunActiveContent.js");
	} else {
		AC_FL_RunContent(
			'codebase', 'http://download.macromedia.com/pub/shockwave/cabs/flash/swflash.cab#version=9,0,0,0',
			'width', '1000',
			'height', '790',
			'src', '/static/ui/v1/flash/newsimtest',
			'quality', 'high',
			'pluginspage', 'http://www.macromedia.com/go/getflashplayer',
			'align', 'middle',
			'play', 'true',
			'loop', 'true',
			'scale', 'showall',
			'wmode', 'window',
			'devicefont', 'false',
			'flashvars','url=/st/demo/interact/interact_readingfillblank.xml&demo=true',
			'id', 'newsimtest',
			'bgcolor', '#ffffff',
			'name', 'newsimtest',
			'menu', 'true',
			'allowFullScreen', 'false',
			'allowScriptAccess','sameDomain',
			'movie', '/static/ui/v1/flash/newsimtest',
			'salign', ''
			); //end AC code
	}
</script>
<noscript><object
	classid="clsid:d27cdb6e-ae6d-11cf-96b8-444553540000"
	codebase="http://download.macromedia.com/pub/shockwave/cabs/flash/swflash.cab#version=9,0,0,0"
	width="1000" height="790" id="newsimtest" align="middle">
	<param name="allowScriptAccess" value="sameDomain" />
	<param name="allowFullScreen" value="false" />
	<param name="movie" value="/static/ui/v1/flash/newsimtest.swf" />
	<param name="quality" value="high" />
	<param name="bgcolor" value="#ffffff" />
	<embed src="/static/ui/v1/flash/newsimtest.swf" quality="high"
		bgcolor="#ffffff" width="1000" height="790" name="simtest"
		align="middle" allowScriptAccess="sameDomain" allowFullScreen="false"
		type="application/x-shockwave-flash"
		pluginspage="http://www.macromedia.com/go/getflashplayer" /></object></noscript>
</body>
</html>