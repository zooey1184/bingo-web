/* CSS Document */
h1 {
	font:Verdana, Arial, Helvetica, sans-serif;
	font-size:18px;
	font-weight:bolder;
}



body {
	font-size:12px;
	line-height:150%;
}



#page-container {
	background:#FFFFFF url(../../images/style/default/contentpage/content_page_bg.jpg) no-repeat;
	min-height:570px;
	MARGIN-RIGHT: auto; MARGIN-LEFT: auto; 
}

/*  
pkg包含�?left, right; left:content-box:content-title:content-body
footer包含�?隐私政策等信息�??
*/
#pkg {
	text-align:left;
	background:#FFFFFF;
	clear:both;
}

#left {
	width:750px;
	float:left;
}

#right {
	float:left;
	width:250px;
}

#nav {
	float:none;
	margin:5px;
	margin-left:20px;
	background:url(../../images/icons/bullet/nav_icon.gif) no-repeat left center;
	padding-left: 24px;
}

#nav a {
		color:#669900;
		font-weight:bold;
		}
#nav a:hover {
		color:#ff9900;
		font-weight:bold;
		}
#nav .back {
			display:block;
			float:right;
			background:url(../../images/icons/btn/back_bullet.gif) left top no-repeat;
			padding-left:20px;
			}

#logo {
  background:url(../../images/style/default/contentpage/content-page-title.gif) no-repeat;
  height:50px;
}

#content-box {
	background:#F3F3F3;
	margin:25px 8px 8px 8px;
}


.imgcontainer {
	display:block;
	padding:0px;	
/*	border: 4px solid White; */
	float:left;
	margin:10px;

}



#content-title {
/*	border:#FFFFFF 1px solid; */
	background:url(../../images/style/default/contentpage/title-div-bg.gif) repeat-x bottom;
	padding:10px 30px 10px 30px;	
}

#content-title h1{
	display:inline;
	background:url(../../images/icons/bullet/icon_subject.gif) no-repeat left;
	padding:5px 5px 5px 20px;
}

#content-body {
	padding:20px;
}

#content-body ul {
				  list-style:none;
				  }
/*
#content-body ul li {
						
						background:url(../../images/icons/bullet/icon_subject.gif) no-repeat left 5px;
						padding-left:20px;
					}
*/
					
#content-body ul li a:visited{
						color:#999999;						
					}


#search {
	text-align:center;
	height:65px;
}

#search-input {
	float:left;
}

#search-img {
	float:right;
}


#tip {
	height:235px;
	margin-top:4px;
	background:url(../../images/style/default/contentpage/content_page_tip_win.jpg) no-repeat;	
}



#list-box {
	padding:0px 5px 5px 20px;
}

#page-footer {
	background: #FFFFFF url(../images/icons/bg/dot_frag_line.gif) repeat-x;
	width:100%;
}

#comment {

}

#comment-list {

}

#comment-write {

}

#err_content {
	border:2px #669900 solid;
	width:auto;
	background:#FFFFFF;
	text-align:left;
	padding:1em;
	margin:0px;
}

