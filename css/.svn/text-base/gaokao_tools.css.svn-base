	width:190px;
	float:right;
	border-width:1px;
	border-style:dashed;
	border-color:#DDDDDD;
	background-color: #FFFFFF;
	margin:3px;
	font-family:"宋体";
}

#xiaoyu_list{
	width:190px;
	float:right;
	border-width:1px;
	border-style:dashed;
	border-color:#DDDDDD;
	background-color: #FFFFFF;
	margin:3px;
	font-family:"宋体";
}

#vocgame{
	border-width:1px;
