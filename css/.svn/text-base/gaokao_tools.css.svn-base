@charset "utf-8";

#div_main_full{
	width:1000px;
	background-color:#FFFFFF;
	float:right;
	text-align:left;
}

#firsttest {
	border-width:1px;
	border-style:dashed;
	border-color:#DDDDDD;
	background-color: #FFFFFF;
	width:790px;
	margin:3px;
	float:left;
}

#firsttest_list{
	width:190px;
	float:left;
	border-width:1px;
	border-style:dashed;
	border-color:#DDDDDD;
	background-color: #FFFFFF;
	margin:3px;
	font-family:"宋体","Arial Black";
}

#vocbook{
	border-width:1px;
	border-style:dashed;
	border-color:#DDDDDD;
	background-color:#FFFFFF;
	width:790px;
	margin:3px;
	float:left;
}
