@charset "utf-8";
/* CSS Document */
*{padding: 0; margin: 0;}

body {
	font-family: "宋体";
	font-size: 13px;
	font-style: normal;
	line-height: 18px;
	font-weight: normal;
	color: #000000;
	text-align:center;
	background-image:url(../images/gaokao_1/bg_top.png);
	background-repeat: repeat-x;
	background-color:#c8e3f1;
	padding-top:10px;
}
input{
	border: 1px solid #D4D0C8;
	font-size:12px;
}
input[type=text],input[type=password] 
{
	background-color:#FFFF88;
	width: 120px;
}
input[type=checkbox],input[type=radio] 
{
	width: 20px;border: 0px;
}
input[type=button],input[type=submit] 
{
	background-color:#3b5888; border-color:#d8dfea #0e1f5b #0e1f5b #d8dfea; border-style:solid; border-width:1px; color:#fff; cursor:pointer; font-size:12px; padding:2px 15px; text-align:center; 
}
a.regnow{
	background: url(/st/images/account/regnow.gif) no-repeat;display: block;width: 86px;height: 25px;margin: 0 auto;cursor: hand;text-indent: -999em;outline:0;
}

#container{
	width:1000px;
	background:#FFFFFF;
	text-align:center;
}

#div_logo{
	background-image:url(../images/gaokao_1/banner.png);
	background-repeat: no-repeat;
	height:134px;
	width:1000px;
}

#div_top_nav{
	color:#FFFFFF;
	font-family:"宋体";
	font-size:12px;
	float:right;
	padding-right:20px;
	padding-top:5px;
	height:30px;
}

#div_top_nav a{
	text-decoration:none;
	color:#FFFFFF;
}

#logo_text{
	height:20px;
	float:left;
	padding-top:100px;
	padding-left:120px;
	font-size:15px;
}
#div_account{
	background-image:url(../images/gaokao_1/login-bar.png);
	background-repeat: no-repeat;
	height:30px;
	padding-top:2px;
	text-align:right;
	font-family:"宋体";
	font-size:12px;
	over-flow:hidden;
}

#div_menu{
	font-family:"宋体";
	width:996px;
	height:50px;
	padding-top:2px;
	color:#FFFFFF;
	float:left;
	border-left-width:1px;
	border-left-color:#FFFFFF;
	border-left-style:solid;
	border-right-width:1px;
	border-right-color:#FFFFFF;
	border-right-style:solid;
}

#div_content{
	width:1000px;
	background-color:#FFFFFF;
	min-heght:500px;
}

#div_topic,#products_category,#category_div{
	width:298px;
	float:left;
	background-image:url(../images/gaokao_1/topic_bg.png);
	background-repeat: repeat-x;
	font-size:14px;
	text-align:left;
	min-height:300px;
	background-position:0px 30px;
}

#div_main{
	float:right;
	width:680px;
	min-height:500px;	
	background-color:#FFFFFF;
}

div.item{
	width:330px;
	min-height:140px;
	font-size:12px;
	font-family:"宋体";
	text-align:left;
	line-height:18px;
	padding:5px;
}

span.title{
	font-weight:bold;
	font-size:14px;
	color:#4e7dc2;
}

div.content{
	padding-top:8px;
	font-weight:normal;
}

span.itemtitle{
	font-size:20px;
	font-weight:bold;
	padding-right:10px;
}
div.title{
	text-align:left;
	border-top-width:1px;
	border-top-style:solid;
	border-top-color;#0000FF;
	background:#88cffc;
}

#div_ent{
	width:1000px;
	height:160px;	
}

#item_1{
	background-image:url(../images/gaokao_1/item_1.png);
	background-repeat:no-repeat;
	height:40px;
	padding-left:50px;
	padding-top:12px;
	text-align:left;
	font-family:"宋体";
}

#item_2{
	background-image:url(../images/gaokao_1/item_2.png);
	background-repeat:no-repeat;
	height:40px;
	padding-left:50px;
	padding-top:12px;
	text-align:left;
	font-family:"宋体";
}

#item_3{
	background-image:url(../images/gaokao_1/item_3.png);
	background-repeat:no-repeat;
	height:40px;
	padding-left:50px;
	padding-top:12px;
	text-align:left;
	font-family:"宋体";
}

#item_4{
	background-image:url(../images/gaokao_1/item_4.png);
	background-repeat:no-repeat;
	height:40px;
	padding-left:50px;
	padding-top:12px;
	text-align:left;
	font-family:"宋体";
}

#item_5{
	background-image:url(../images/gaokao_1/item_5.png);
	background-repeat:no-repeat;
	height:40px;
	padding-left:50px;
	padding-top:12px;
	text-align:left;
	font-family:"宋体";
}

/*
尾页的形式
*/
#footer{
	background-image:url(../images/gaokao_1/bg_bottom.png);
	height:304px;
	line-height:20px;
	width:100%;
	padding:0px;
}

#footer_inner{
	background-image:url(../images/gaokao_1/page_bottom.png);
	background-repeat:no-repeat;
	height:304px;
	width:1000px;
	font-family:"宋体";
	text-align:center;
}

#footer_text{
	text-align:center;
}
#footer a{
	color:#222222;
	text-decoration:none;
}

#footer a:hover{
	color:#FF9900;
}

.copyright{
	font-size:13px;
	font-family:"宋体";
}
.dashedhr{
	height:1px;
	border-bottom-width:1px;
	border-bottom-style:dashed;
	border-bottom-color:#33CCCC;
	color:#FFFFFF;
}

div.topictitle{
	font-family:"宋体";
	font-size:14px;
	text-align:center;
	height:25px;
	margin-bottom:10px;
	padding-top:5px;
	margin-top:3px;
	border-bottom-width:1px;
	border-bottom-color:#FFFFFF;
	border-bottom-style:solid;
	width:98%;
}

.menu_item{
	background-image: url(../images/gaokao_1/menu_splitter.png);
	background-position: right;
	background-repeat: no-repeat;
	font-family:"宋体";
	width:150px;
}

.menu_item_last{
	background-position: -1000;
	background-repeat: no-repeat;
	font-family:"宋体";
	width:150px;
}
.menu_current{
	background-image: url(../images/gaokao_1/menu_current.png);
	background-repeat: no-repeat;
	width:150px;
	height:35px;
	padding-top:7px;
	background-position: center;
}

.menu_no_current{
	background-image: url(../images/gaokao_1/menu_no_current.png);
	background-repeat: no-repeat;
	width:150px;
	height:35px;
	padding-top:7px;
}

.menu_current a{
	color:#FFFFFF;
	text-decoration:none;
}

.menu_no_current a{
	color:#FFFFFF;
	text-decoration:none;
}

.menu_current a:hover{
	color:#FF9900;
	text-decoration:underline;
}

.menu_no_current a:hover{
	color:#FF9900;
	text-decoration:underline;
}


#div_main_full{
	width:100%;
}

.left{
  padding-left:6px;
}

#products_div{
	float:left;
	width:700px;
}

.topic_header{
	width:298px;
	height:40px;
	background-image:url(../images/gaokao_1/topic_bg_header.png);
	background-repeat: no-repeat;
}

.newstitle{
	font-weight:bold;
}
.date{
	font-style:italic;
}
.content{
	font-family:"Times New Roman";
	padding:5px;
}

.topic_header_text{
	font-family:"幼圆";
	font-weight:normal;
	font-size:14px;
	border-top-width:1px;
	border-top-color:#FFCC00;
	border-top-style:solid;
	height:30px;
}
p{
	text-indent:2em;
}
.hover{
	background:#FFCC00;
	cursor:hand;
	color:#FFFFFF;
}

#bingointro td{
	font-size:13px;
	font-family:"宋体";
}

a{
	color:#35adf9;
	text-decoration:none;
}
a:hover{
	color:#FFCC00;
	text-decoration:underline;
}

.word_token{
	float:left;
	min-width:100px;
	border-width:1px;
	border-color:#999999;
	border-style:dashed;
	height:30px;
	text-align:center;
	margin:5px;
}

.word_item{
	border-top-width:1px;
	border-top-color:#FFCC00;
	border-top-style:solid;
	padding-top:10px;
	margin:10px;
}
#dynamic_word_div{
	height:200px;
	overflow:hidden;
	visibility: inherit;
	
}
#word_title{
	border-width:1px;
	border-color:#DDDDDD;
	border-style:dashed;
}
#other_word{
	border-width:1px;
	border-color:#DDDDDD;
	border-style:dashed;
	font-size:12px;
	font-family:"宋体";
}
.cleared{
	clear:both;
}

/*----------栏目菜单*/
.cbody{
	width:996px;
	margin:0 auto;
}
.topmenu{
	width:996px;
	height:40px;
	background:url(../images/topmenu_bg.gif) left top repeat-x;
}
.topmenu ul{
	width:996px;
	height:40px;
	background:url(../images/topmenu_r.gif) top center no-repeat;
	overflow:hidden;
}
.topmenu ul li{
	float:left;
	min-width:80px;
	margin-left:-2px;
	text-align:center;
	background:url(../images/topmenu_bg.gif) left bottom no-repeat;
}
.topmenu ul li a{
	float:left;
	color:#FFFFFF;
	display:block;
	padding-left:17px;
	padding-right:15px;
	text-decoration:none;
	height:40px;
	line-height:37px;
	font-size:14px;
}
.topmenu ul li a:hover{
	color:#FFFF99;
	background:url(../images/topmenu_o.gif) center bottom no-repeat;
}
.topmenu ul li a.thisclass{
	color:#FFFF99;
	background:url(../images/topmenu_o.gif) center bottom no-repeat;
}
.topmenu .rssbut{
	position:relative;
	float:right;
	margin:-30px 8px auto;
	display:inline;
}
.topic_heaer_text{
	font-size:14px;
	font-family:"宋体";
	padding-bottom:10px;
	border-bottom-width:1px;
	border-bottom-style:dashed;
	border-bottom-color:#FFFFFF;
}
#ad{
	margin-top:10px;
}

#table_target{
	font-size:14px;
	font-family:"宋体";
	font-weight:500;
}

#partners{
	margin-top:20px;
	background-image: url(/st/images/y_parterner.png);
	background-repeat: no-repeat;
	width:250px;
	height:120px;
	font-size:11px;
	text-align:center;
	color:#FFFFFF;
	padding-top:10px;
}

.partner_title{
	font-size:14px;
	color:#FFFFFF;
	text-align:center;
	height:35px;
}

#firsttest{
	font-family:"宋体";
	margin-top:10px;
}
#div_back{
	background-image: url(/st/images/nav.gif);
	background-repeat: no-repeat;
	background-position: right;
	width:986px;
	text-align:right;
	height:37px;
}

#div_back a{
	color:#FFFFFF;
	font-size:15px;
	font-family:"幼圆";
	font-weight:bold;
}
#current_location{
	background-color:#e7f5ff;
	border-top-color:#0377b2;
	border-top-width:2px;
	border-top-style:solid;
	height:25px;
	width:100%;
	font-size:15px;
	font-weight:bold;
	clear:both;
	text-align:left;
	font-family:"宋体";
	padding-top:3px;
}
#pic_news_div{
	margin-top:8px;
	margin-left:5px;
	border-width:1px;
	border-color:#EEEEEE;
	border-style:solid;
	width:650px;
	background:#ddf2fc;
	float:left;
}

#pic_news_div a{
	color:#0000AA;
}
.pic_news_header{
	height:22px;
	margin:1px auto 0px;
	background:url(/st/images/index_1/topline_botbg.gif) 0px -20px repeat-x;
	border-bottom:1px solid #EEE;
	text-align:left;
	font-size:14px;
	font-weight:bold;
	color:#0000FF;
}

#top_news_div{
	margin-top:8px;
	margin-left:5px;
	width:320px;
	float:left;
	border-width:1px;
	border-color:#EEEEEE;
	border-style:solid;
	text-align:left;
	background:#eaf6fc;
	
}

.top_news_header{
	height:22px;
	margin:1px auto 0px;
	background:url(/st/images/index_1/topline_botbg.gif) 0px -20px repeat-x;
	border-bottom:1px solid #EEE;
	text-align:left;
	font-size:14px;
	font-weight:bold;
	color:#0000FF;
}
.pic_news_item_div{
	width:140px;
	height:115px;
	overflow:hidden;
	background:#ddf2fc;
	float:left;
	padding:3px;
	margin-left:5px;
	margin-right:5px;
	text-align:left;
	font-family:Arail;
}
.pic_news_item_div a{
	color:#0000AA;
}
.headline_news_item_div{
	width:300px;
	height:20px;
	overflow:hidden;
	padding-left:10px;
}
.headline_news_item_div a{
	color:#0000AA;
	background-image: url(/st/images/index_1/ico_2.gif);
	background-repeat:no-repeat;
	padding-left:12px;
}
.more{
	width:100px;
	float:right;
	text-align:right;
}
.header_content{
	float:left;
	width:100px;
}